# Composio credentials — copy to a real, gitignored location.
# Never commit actual keys. See README.md "MCP / Composio".

# 1. Composio Connect (consumer) key — used by the `composio` server in agent/mcp.json
#    Get it at https://app.composio.dev → For You → Connect → Settings → Sessions & API Key
#    Looks like: ck_xxxxxxxxxxxxxxxx
#    Either export this var, or write the bare key to ~/.config/composio/api-key (chmod 600)
COMPOSIO_CONNECT_API_KEY=REPLACE_ME_ck_KEY

# 2. Composio Platform (developer) project key — only needed for `composio-platform`
#    https://app.composio.dev → Project Settings → API Keys
#    Looks like: ak_xxxxxxxxxxxxxxxx
#    Write it to ~/.config/composio/platform-api-key (chmod 600)
COMPOSIO_API_KEY=REPLACE_ME_ak_KEY

# Optional: the user id Composio scopes the session to (for Platform sessions).
# COMPOSIO_USER_ID=REPLACE_ME
